VITE_API_BASE_URL=https://app.clicpilates.com

# ID de medición de Google Analytics 4 (formato G-XXXXXXXXXX).
# Sin esta variable la analítica queda desactivada (útil en desarrollo).
VITE_GA_MEASUREMENT_ID=

# Pixel de Meta de la marca (el que cubre a todas las sedes por defecto).
# Las sedes que hacen publicidad con su propia cuenta cargan su pixel en el
# backoffice de Clicnet (Sede > Perfil público), no acá.
# Sin esta variable el tracking de Meta queda desactivado.
VITE_META_PIXEL_ID=
